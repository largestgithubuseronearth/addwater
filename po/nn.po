msgstr ""
"Klarte ikkje sjekke etter temaoppdateringar på grunn av eit nettverksproblem"

#: src/utils/background.py:103
msgid "Theme Installation failed"
msgstr "Temainstallasjonen mislukkast"

#: src/utils/background.py:104
