msgstr "네트워크 문제로 업데이트 확인에 실패했습니다"

#: src/page.py:97
msgid "Failed to check for updates. Please try again later."
msgstr "업데이트 확인에 실패했습니다. 나중에 다시 시도하십시오."

#: src/page.py:99
msgid "Unknown error has occurred. Please report this to developer."
msgstr "알 수 없는 오류가 나타났습니다. 이 문제를 개발자에게 보고하십시오."

#: src/page.py:117
msgid "Installed Theme. Restart Firefox to see changes."
msgstr ""
"테마를 설치했습니다. 바뀐 상태를 보려면 파이어폭스를 다시 시작하십시오."

#: src/page.py:123
msgid "Removed Theme. Restart Firefox to see changes."
msgstr ""
"테마를 제거했습니다. 바뀐 상태를 보려면 파이어폭스를 다시 시작하십시오."

#: src/page.py:126
msgid "Installation failed"
msgstr "설치 실패"

#: src/page.py:132
msgid "Changes reverted"
msgstr "변경 복원함"

